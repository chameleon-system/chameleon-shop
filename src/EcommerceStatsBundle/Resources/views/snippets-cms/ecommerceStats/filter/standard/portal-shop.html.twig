{% if portalOptions|length > 1 or shopOptions|length > 1%}
    <div class="row">
    {% if portalOptions|length > 1 %}
        {{ include('@ChameleonSystemEcommerceStats/snippets-cms/ecommerceStats/filter/field/select.html.twig', {
            name: 'portalId',
            label: 'chameleon_system_ecommerce_stats.form_portal'|trans,
            options: portalOptions,
            selectedValue: selectedPortalId,
            dataParam: 'portalId',
            addProduceParamsClass: true,
            emptyOptionLabel: 'chameleon_system_ecommerce_stats.all_portals'|trans,
            emptyOptionValue: '',
            colClass: 'col-6',
        }) }}
    {% endif %}
    {% if shopOptions|length > 1 %}
        {{ include('@ChameleonSystemEcommerceStats/snippets-cms/ecommerceStats/filter/field/select.html.twig', {
            name: 'shopId',
            label: 'chameleon_system_ecommerce_stats.form_shop'|trans,
            options: shopOptions,
            selectedValue: selectedShopId,
            dataParam: 'shopId',
            addProduceParamsClass: true,
            emptyOptionLabel: 'chameleon_system_ecommerce_stats.all_shops'|trans,
            emptyOptionValue: '',
            colClass: 'col-6',
        }) }}
    {% endif %}
    </div>
{% endif %}
