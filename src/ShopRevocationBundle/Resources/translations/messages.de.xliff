                <target>Bitte geben Sie eine Bestellnummer ein.</target>
            </trans-unit>
            <trans-unit id="chameleon_system_shop_revocation.validation.order_number_not_found">
                <source>chameleon_system_shop_revocation.validation.order_number_not_found</source>
                <target>Die angegebene Bestellnummer wurde nicht gefunden.</target>
            </trans-unit>
            <trans-unit id="chameleon_system_shop_revocation.validation.email_order_mismatch">
                <source>chameleon_system_shop_revocation.validation.email_order_mismatch</source>
                <target>Die E-Mail-Adresse passt nicht zur Bestellung.</target>
            </trans-unit>
            <trans-unit id="chameleon_system_shop_revocation.validation.order_number_not_relevant">
                <source>chameleon_system_shop_revocation.validation.order_number_not_relevant</source>
                <target>Die angegebene Bestellung liegt voraussichtlich nicht mehr innerhalb der Widerrufsfrist.</target>
            </trans-unit>
            <trans-unit id="chameleon_system_shop_revocation.validation.selected_order_not_found">
                <source>chameleon_system_shop_revocation.validation.selected_order_not_found</source>
                <target>Die ausgewählte Bestellung wurde nicht gefunden.</target>
            </trans-unit>
            <trans-unit id="chameleon_system_shop_revocation.validation.selected_order_not_owned">
                <source>chameleon_system_shop_revocation.validation.selected_order_not_owned</source>
                <target>Die ausgewählte Bestellung gehört nicht zu Ihrem Kundenkonto.</target>
            </trans-unit>
            <trans-unit id="chameleon_system_shop_revocation.validation.selected_order_not_relevant">
                <source>chameleon_system_shop_revocation.validation.selected_order_not_relevant</source>
                <target>Die ausgewählte Bestellung liegt voraussichtlich nicht mehr innerhalb der Widerrufsfrist.</target>
            </trans-unit>
            <trans-unit id="chameleon_system_shop_revocation.validation.order_number_not_owned">
                <source>chameleon_system_shop_revocation.validation.order_number_not_owned</source>
                <target>Die angegebene Bestellung gehört nicht zu Ihrem Kundenkonto.</target>
            </trans-unit>
