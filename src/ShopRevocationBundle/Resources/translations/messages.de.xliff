        <body>
            <trans-unit id="chameleon_system_shop_revocation.form.headline">
                <source>chameleon_system_shop_revocation.form.headline</source>
                <target>Vertrag widerrufen</target>
            </trans-unit>
            <trans-unit id="chameleon_system_shop_revocation.form.intro_text">
                <source>chameleon_system_shop_revocation.form.intro_text</source>
                <target>Über dieses Formular können Sie Ihren Widerruf elektronisch übermitteln.</target>
            </trans-unit>
            <trans-unit id="chameleon_system_shop_revocation.form.customer_note_help_text">
                <source>chameleon_system_shop_revocation.form.customer_note_help_text</source>
                <target>Optional können Sie angeben, welche Artikel Sie widerrufen möchten.</target>
            </trans-unit>
            <trans-unit id="chameleon_system_shop_revocation.form.submit">
                <source>chameleon_system_shop_revocation.form.submit</source>
                <target>Widerruf bestätigen</target>
            </trans-unit>
            <trans-unit id="chameleon_system_shop_revocation.field.name">
                <source>chameleon_system_shop_revocation.field.name</source>
                <target>Name</target>
            </trans-unit>
            <trans-unit id="chameleon_system_shop_revocation.field.email">
                <source>chameleon_system_shop_revocation.field.email</source>
                <target>E-Mail-Adresse</target>
            </trans-unit>
            <trans-unit id="chameleon_system_shop_revocation.field.order">
                <source>chameleon_system_shop_revocation.field.order</source>
                <target>Bestellung</target>
            </trans-unit>
            <trans-unit id="chameleon_system_shop_revocation.field.order_number">
                <source>chameleon_system_shop_revocation.field.order_number</source>
                <target>Bestellnummer</target>
            </trans-unit>
            <trans-unit id="chameleon_system_shop_revocation.field.customer_note">
                <source>chameleon_system_shop_revocation.field.customer_note</source>
                <target>Welche Artikel möchten Sie widerrufen?</target>
            </trans-unit>
            <trans-unit id="chameleon_system_shop_revocation.field.select_placeholder">
                <source>chameleon_system_shop_revocation.field.select_placeholder</source>
                <target>Bitte wählen</target>
            </trans-unit>
            <trans-unit id="chameleon_system_shop_revocation.action.contact">
                <source>chameleon_system_shop_revocation.action.contact</source>
                <target>Kontakt</target>
            </trans-unit>
            <trans-unit id="chameleon_system_shop_revocation.hint.invalid_order">
                <source>chameleon_system_shop_revocation.hint.invalid_order</source>
                <target>Sollte Ihre Bestellung trotzdem widerrufbar sein, nutzen Sie bitte unser Kontaktformular.</target>
            </trans-unit>
            <trans-unit id="chameleon_system_shop_revocation.hint.no_relevant_orders">
                <source>chameleon_system_shop_revocation.hint.no_relevant_orders</source>
                <target>Es wurden keine relevanten Bestellungen gefunden. Wenn Ihre Bestellung dennoch widerrufbar sein sollte, geben Sie die Bestellnummer bitte manuell ein.</target>
            </trans-unit>
            <trans-unit id="chameleon_system_shop_revocation.error.check_input">
                <source>chameleon_system_shop_revocation.error.check_input</source>
                <target>Bitte prüfen Sie Ihre Eingaben.</target>
            </trans-unit>
            <trans-unit id="chameleon_system_shop_revocation.error.save_failed">
                <source>chameleon_system_shop_revocation.error.save_failed</source>
                <target>Der Widerruf konnte aktuell nicht gespeichert werden. Bitte versuchen Sie es erneut.</target>
            </trans-unit>
            <trans-unit id="chameleon_system_shop_revocation.success.submitted">
                <source>chameleon_system_shop_revocation.success.submitted</source>
                <target>Ihr Widerruf wurde erfolgreich übermittelt.</target>
            </trans-unit>
            <trans-unit id="chameleon_system_shop_revocation.validation.name_required">
                <source>chameleon_system_shop_revocation.validation.name_required</source>
                <target>Bitte geben Sie Ihren Namen ein.</target>
            </trans-unit>
            <trans-unit id="chameleon_system_shop_revocation.validation.email_required">
                <source>chameleon_system_shop_revocation.validation.email_required</source>
                <target>Bitte geben Sie Ihre E-Mail-Adresse ein.</target>
            </trans-unit>
            <trans-unit id="chameleon_system_shop_revocation.validation.email_invalid">
                <source>chameleon_system_shop_revocation.validation.email_invalid</source>
